use pkg::tests::suite::{close, expect, linspace, rel, sorted, throws_kind, uniform};
use pkg::{Boundary, Curve, Extrapolate, StepKind};
use core::array::{Array, Vector};

fn cubic(x: f64) -> f64 { 0.5 * x * x * x - 2.0 * x * x + x - 3.0 }

fn dcubic(x: f64) -> f64 { 1.5 * x * x - 4.0 * x + 1.0 }

fn ddcubic(x: f64) -> f64 { 3.0 * x - 4.0 }

#[test]
fn linear_exact_for_lines() {
    let x = sorted(50, -3.0, 7.0, 1);
    let y = x .* 2.5 .- 1.0;
    let f = try! pkg::linear(x, y);
    let q = uniform(200, -5.0, 9.0, 2);
    let v = f.eval(q);
    for i in 0..q.len() { close(v[i], 2.5 * q[i] - 1.0, 1e-12, "line"); }
    // Sorted eval walks; it must agree with `at`.
    let s = linspace(-5.0, 9.0, 301);
    let vs = f.eval(s);
    for i in 0..s.len() { expect(vs[i] == f.at(s[i]), "eval = at"); }
    // Exact at the nodes.
    for i in 0..x.len() { expect(f.at(x[i]) == y[i], "node"); }
}

#[test]
fn linear_modes_and_nan() {
    let f = try! pkg::linear([0, 1, 2], [0, 1, 4]);
    expect(f.at(3.0) == 7.0, "extend");
    expect(f.extrapolate(Extrapolate::Clamp).at(-1.0) == 0.0, "clamp");
    expect(f.extrapolate(Extrapolate::Fill(9.0)).at(2.5) == 9.0, "fill");
    close(f.extrapolate(Extrapolate::Periodic).at(2.5), 0.5, 1e-15, "periodic");
    close(f.extrapolate(Extrapolate::Periodic).at(-0.5), 2.5, 1e-15, "periodic left");
    expect(f.at(f64::NAN).is_nan(), "nan in, nan out");
    let m: Array<f64, 2> = [[0.5, 1.5], [2, 0]];
    let v = f.eval(m);
    expect(v.shape() == [2, 2] && v[0, 1] == 2.5 && v[1, 1] == 0.0, "rank-2 eval keeps the shape");
}

#[test]
fn input_errors() {
    expect(throws_kind(|| { _ = try pkg::linear([0, 1, 1], [0, 1, 2]); }, "NotSorted"), "repeated x");
    expect(throws_kind(|| { _ = try pkg::linear([0, 1], [0, 1, 2]); }, "LengthMismatch"), "lengths");
    expect(throws_kind(|| { _ = try pkg::linear([0], [0]); }, "TooFewPoints"), "one point");
    expect(throws_kind(|| { _ = try pkg::cubic_spline([0.0, f64::NAN], [0, 1]); }, "NotFinite"), "nan x");
    expect(throws_kind(|| { _ = try pkg::pchip([0, 1], [0.0, f64::INFINITY]); }, "NotFinite"), "inf y");
    expect(throws_kind(|| { _ = try pkg::cubic_spline_with([0, 1, 2], [0, 1, 2], Boundary::Periodic); }, "BadArgument"), "periodic ends");
    let empty: Vector<f64> = Array::zeros([0]);
    expect(throws_kind(|| { _ = try pkg::akima(empty, empty); }, "TooFewPoints"), "empty");
}

#[test]
fn steps() {
    let x: Vector<f64> = [0, 1, 2];
    let y: Vector<f64> = [10, 11, 12];
    let n = try! pkg::nearest(x, y);
    let p = try! pkg::previous(x, y);
    let q = try! pkg::next(x, y);
    expect(n.at(0.5) == 10.0 && n.at(0.51) == 11.0 && n.at(-4.0) == 10.0 && n.at(9.0) == 12.0, "nearest");
    expect(p.at(0.99) == 10.0 && p.at(1.0) == 11.0 && p.at(5.0) == 12.0, "previous");
    expect(q.at(0.01) == 11.0 && q.at(1.0) == 11.0 && q.at(1.01) == 12.0 && q.at(-1.0) == 10.0, "next");
    expect(n.extrapolate(Extrapolate::Fill(-1.0)).at(2.1) == -1.0, "fill");
    let one = try! pkg::step([3], [7], StepKind::Nearest);
    expect(one.at(-100.0) == 7.0, "one sample");
}

#[test]
fn barycentric_exact_for_polynomials() {
    let x = sorted(9, -2.0, 2.0, 3);
    let y = x.map(|t: f64| -> f64 { t ** 8 - 3.0 * t ** 5 + t - 1.0 });
    let p = try! pkg::barycentric(x, y);
    for t in linspace(-2.0, 2.0, 41) { rel(p.at(t), t ** 8 - 3.0 * t ** 5 + t - 1.0, 1e-10, "degree 8 through 9 nodes"); }
    // Runge's function on 101 Chebyshev points: near machine precision.
    let c = Vector::<f64>::from_fn([101], |i: [usize; 1]| -> f64 { -(f64::PI * (i[0] as f64) / 100.0).cos() });
    let r = try! pkg::barycentric(c, c.map(|t: f64| -> f64 { 1.0 / (1.0 + 25.0 * t * t) }));
    let worst = 0.0;
    for t in linspace(-1.0, 1.0, 1001) { worst = worst.max((r.at(t) - 1.0 / (1.0 + 25.0 * t * t)).abs()); }
    expect(worst < 1e-8, f"Runge on Chebyshev points: {worst}");
}

#[test]
fn cubic_spline_reproduces_cubics() {
    let x = sorted(30, -2.0, 5.0, 4);
    let y = x.map(cubic);
    let s = try! pkg::cubic_spline(x, y);
    for t in linspace(-3.0, 6.0, 91) { rel(s.at(t), cubic(t), 1e-10, "not-a-knot cubic"); }
    let d1 = s.derivative(1);
    let d2 = s.derivative(2);
    for t in linspace(-2.0, 5.0, 31) {
        rel(d1.at(t), dcubic(t), 1e-9, "slope");
        rel(d2.at(t), ddcubic(t), 1e-8, "curvature");
    }
    // Exact end slopes and curvatures reproduce it too.
    let (a, b) = (x[0], x[x.len() - 1]);
    let sl = try! pkg::cubic_spline_with(x, y, Boundary::Slopes(dcubic(a), dcubic(b)));
    let cv = try! pkg::cubic_spline_with(x, y, Boundary::Curvatures(ddcubic(a), ddcubic(b)));
    for t in linspace(a, b, 41) {
        rel(sl.at(t), cubic(t), 1e-10, "clamped to exact slopes");
        rel(cv.at(t), cubic(t), 1e-10, "exact curvatures");
    }
    // Two points: the line; three: the parabola.
    let l = try! pkg::cubic_spline([0, 2], [1, 5]);
    expect(l.at(1.0) == 3.0, "line");
    let q = try! pkg::cubic_spline([0, 1, 3], [0, 1, 9]);
    close(q.at(2.0), 4.0, 1e-14, "parabola");
}

#[test]
fn natural_and_clamped_closed_forms() {
    // (0, 0), (1, 1), (2, 0), natural: M1 = -3, s = 1.5 x - 0.5 x^3 on [0, 1].
    let s = try! pkg::cubic_spline_with([0, 1, 2], [0, 1, 0], Boundary::Natural);
    close(s.at(0.5), 0.6875, 1e-15, "natural");
    close(s.derivative(2).at(1.0), -3.0, 1e-14, "M1");
    close(s.at(1.5), 0.6875, 1e-15, "symmetry");
    // Clamped (zero slopes): on [0, 1] s = 3 x^2 - 2 x^3, smoothstep.
    let c = try! pkg::cubic_spline_with([0, 1, 2], [0, 1, 0], Boundary::Clamped);
    close(c.at(0.5), 0.5, 1e-15, "smoothstep");
    close(c.derivative(1).at(1.0), 0.0, 1e-15, "flat top");
    // C2 at every knot.
    let x = sorted(20, 0.0, 10.0, 5);
    let y = uniform(20, -1.0, 1.0, 6);
    let n = try! pkg::cubic_spline_with(x, y, Boundary::Natural);
    let d1 = n.derivative(1);
    let d2 = n.derivative(2);
    for i in 1..19 {
        let (l, r) = (d1.piece(i - 1, x[i]), d1.piece(i, x[i]));
        close(l, r, 1e-9 * (1.0 + l.abs()), "C1");
        let (l2, r2) = (d2.piece(i - 1, x[i]), d2.piece(i, x[i]));
        close(l2, r2, 1e-8 * (1.0 + l2.abs()), "C2");
    }
    close(d2.at(0.0 + x[0]), 0.0, 1e-12, "natural start");
}

#[test]
fn periodic_spline() {
    let x = linspace(0.0, 2.0 * f64::PI, 33);
    let y = f64::sin.(x);
    y[32] = y[0];
    let s = try! pkg::cubic_spline_with(x, y, Boundary::Periodic);
    let worst = 0.0;
    for t in linspace(0.0, 2.0 * f64::PI, 401) { worst = worst.max((s.at(t) - t.sin()).abs()); }
    expect(worst < 2e-5, f"periodic sine: {worst}");
    let (d1, d2) = (s.derivative(1), s.derivative(2));
    close(d1.at(0.0), d1.at(2.0 * f64::PI), 1e-12, "slope wraps");
    close(d2.at(0.0), d2.at(2.0 * f64::PI), 1e-10, "curvature wraps");
    let p = s.extrapolate(Extrapolate::Periodic);
    close(p.at(7.0), p.at(7.0 - 2.0 * f64::PI), 1e-14, "periodic extrapolation");
    close(p.integrate(0.0..4.0 * f64::PI), 0.0, 1e-12, "two periods of sine");
    // Three points: the 2 x 2 cyclic case.
    let t = try! pkg::cubic_spline_with([0, 1, 2], [1, 3, 1], Boundary::Periodic);
    close(t.derivative(1).at(0.0), t.derivative(1).at(2.0), 1e-14, "3 points");
}

#[test]
fn pchip_is_monotone() {
    for seed in 0u64..20 {
        let x = sorted(25, 0.0, 10.0, 100 + seed);
        let steps = uniform(25, 0.0, 1.0, 200 + seed);
        // Rising data with flat runs.
        let y = List::filled(25, 0.0);
        for i in 1..25 { y[i] = y[i - 1] + (if steps[i] < 0.3 { 0.0 } else { steps[i] }); }
        let p = try! pkg::pchip(x, Vector::<f64>::from(y));
        let prev = p.at(x[0]);
        for t in linspace(x[0], x[24], 2001) {
            let v = p.at(t);
            expect(v >= prev - 1e-12, f"pchip falls at {t} (seed {seed})");
            prev = v;
        }
        // No overshoot: each piece stays between its end values.
        for i in 0..24 {
            for t in linspace(x[i], x[i + 1], 11) {
                let v = p.at(t);
                expect(v >= y[i] - 1e-12 && v <= y[i + 1] + 1e-12, "within the step");
            }
        }
    }
    // Exact for lines; C1.
    let x = sorted(10, -1.0, 1.0, 7);
    let p = try! pkg::pchip(x, x .* 3.0 .+ 1.0);
    for t in linspace(-1.0, 1.0, 21) { close(p.at(t), 3.0 * t + 1.0, 1e-13, "line"); }
    let q = try! pkg::pchip([0, 1, 2, 3], [0, 1, 0, 1]);
    let d = q.derivative(1);
    close(d.piece(0, 1.0), d.piece(1, 1.0), 1e-15, "C1");
    expect(d.at(1.0) == 0.0, "extremum gets slope 0");
}

#[test]
fn akima_family() {
    let x = sorted(15, 0.0, 5.0, 8);
    for p in [try! pkg::akima(x, x .* 2.0), try! pkg::makima(x, x .* 2.0)] {
        for t in linspace(0.0, 5.0, 26) { close(p.at(t), 2.0 * t, 1e-13, "line"); }
    }
    // An outlier moves only nearby pieces.
    let xs = linspace(0.0, 10.0, 11);
    let ys = List::filled(11, 0.0);
    ys[5] = 1.0;
    let a = try! pkg::akima(xs, Vector::<f64>::from(ys));
    expect(a.at(1.5) == 0.0 && a.at(8.5) == 0.0, "local");
    // makima has no overshoot next to a flat run.
    let m = try! pkg::makima([0, 1, 2, 3, 4, 5], [0, 0, 0, 1, 1, 1]);
    for t in linspace(3.0, 5.0, 21) { close(m.at(t), 1.0, 1e-15, "flat after the step"); }
}

#[test]
fn hermite_and_ppoly_calculus() {
    let x = sorted(12, 0.0, 3.0, 9);
    let p = try! pkg::cubic_hermite(x, x.map(cubic), x.map(dcubic));
    for t in linspace(0.0, 3.0, 31) { rel(p.at(t), cubic(t), 1e-12, "hermite"); }
    let (a, b) = (x[0], x[11]);
    let exact = |t: f64| -> f64 { 0.125 * t ** 4 - 2.0 / 3.0 * t ** 3 + 0.5 * t * t - 3.0 * t };
    rel(p.integrate(a..b), exact(b) - exact(a), 1e-12, "integral");
    rel(p.integrate(b..a), exact(a) - exact(b), 1e-12, "reversed");
    let f = p.antiderivative(1);
    rel(f.at(b) - f.at(a), exact(b) - exact(a), 1e-12, "antiderivative");
    rel(f.derivative(1).at(1.3), p.at(1.3), 1e-12, "d/dx of the antiderivative");
    // Roots of the cubic (-0.7..., 0.4..., 3.2...): two in [0, 3].
    let r = p.roots();
    for v in r { close(cubic(v), 0.0, 1e-11, "root"); }
    let c = try! pkg::cubic_spline([0, 1, 2, 3, 4], [1, -1, 1, -1, 1]);
    expect(c.roots().len() == 4, f"{c.roots():?}");
    for v in c.solve(0.5) { close(c.at(v), 0.5, 1e-13, "solve"); }
    // A root at a knot shows once.
    let z = try! pkg::linear([0, 1, 2], [-1, 0, 1]);
    expect(z.ppoly().roots() == Vector::<f64>::from([1.0]), "root at a knot");
    // Clamp and Fill in integrate.
    let one = try! pkg::linear([0, 1], [1, 1]);
    close(one.ppoly().extrapolate(Extrapolate::Clamp).integrate(-1.0..3.0), 4.0, 1e-15, "clamp integral");
    close(one.ppoly().extrapolate(Extrapolate::Fill(0.0)).integrate(-1.0..3.0), 1.0, 1e-15, "fill integral");
}

#[test]
fn extreme_scales() {
    // Tiny and huge abscissae and ordinates give the same shape, while
    // the power-basis coefficients (y / h^3) stay in range.
    let x = sorted(15, 0.0, 1.0, 11);
    let y = uniform(15, -1.0, 1.0, 12);
    let base = try! pkg::cubic_spline(x, y);
    for (sx, sy) in [(1e-100, 1e-100), (1e100, 1e100), (1e-50, 1e50), (1e50, 1e-50)] {
        let s = try! pkg::cubic_spline(x .* sx, y .* sy);
        let p = try! pkg::pchip(x .* sx, y .* sy);
        let q = try! pkg::pchip(x, y);
        for t in linspace(x[0], x[14], 23) {
            rel(s.at(t * sx) / sy, base.at(t), 1e-9, f"spline at scale {sx}, {sy}");
            rel(p.at(t * sx) / sy, q.at(t), 1e-9, f"pchip at scale {sx}, {sy}");
        }
    }
    let b = try! pkg::barycentric(x .* 1e200, y);
    rel(b.at(x[3] * 1e200), y[3], 1e-15, "barycentric at a huge node");
    expect(b.at(0.5e200).is_finite(), "barycentric weights do not overflow");
    for f in [base.func(), (try! pkg::akima(x, y)).func(), (try! pkg::linear(x, y)).func()] {
        expect(f(f64::NAN).is_nan(), "NaN query");
    }
}

#[test]
fn takes_lists_ranges_and_other_types() {
    // Every 1-d input is a `linalg::AsVector<f64>`.
    let xs: List<f64> = [0.0, 1.0, 2.0, 3.0];
    let ys: List<i64> = [0, 1, 8, 27];
    let a = try! pkg::cubic_spline(xs, ys);
    let b = try! pkg::cubic_spline(0..4, [0f32, 1f32, 8f32, 27f32]);
    expect(a.at(1.5) == b.at(1.5), "same spline from a list and a range");
    expect(a.at(1.5).is_close(3.375), "x^3 at 1.5");
}
