//! The 2-d Delaunay triangulation by a radial sweep and edge flips
//! (Mapbox's Delaunator, after Sinclair's S-hull): seed with the
//! smallest circumcircle near the center, add the points by distance
//! from it, each to the visible part of the convex hull, and flip every
//! new edge that fails the empty-circle test. Orientation and in-circle
//! tests are exact (Shewchuk), so cocircular sets (grids) come out
//! consistent and every flip loop ends. O(n log n) expected.

use pkg::InterpError;
use pkg::data::{arg, finite, list};
use pkg::scatter::predicates::{incircle, orient2d};
use core::array::{Array, Matrix, Vector};

const NONE: isize = -1;

/// A Delaunay triangulation of points in the plane: no point lies
/// strictly inside the circumcircle of any triangle. Repeated points
/// are kept once (the first in sweep order); triangles turn
/// counterclockwise.
///
/// ```nabi
/// use interpolate::scatter::Delaunay;
/// use core::array::Matrix;
///
/// let p: Matrix<f64> = [[0, 0], [1, 0], [0, 1], [1, 1]];
/// let d = try Delaunay::new(p);
/// assert(d.len() == 2 && d.hull().len() == 4);
/// assert(d.find_simplex([0.2, 0.2]) != none);
/// assert(d.find_simplex([2.0, 2.0]) == none);
/// ```
#[derive(Clone)]
pub struct Delaunay {
    pub(pkg) x: List<f64>;
    pub(pkg) y: List<f64>;
    // Triangle t is tri[3t..3t + 3], clockwise; halfedge e runs from
    // tri[e] to tri[next(e)], and half[e] is its twin or NONE.
    pub(pkg) tri: List<usize>;
    pub(pkg) half: List<isize>;
    pub(pkg) hull: List<usize>;
    // A halfedge leaving each vertex, NONE for skipped duplicates.
    pub(pkg) from: List<isize>;
}

fn next(e: usize) -> usize { if e % 3 == 2 { e - 2 } else { e + 1 } }

/// Monotone in the angle of (dx, dy), in [0, 1).
fn pseudo_angle(dx: f64, dy: f64) -> f64 {
    let p = dx / (dx.abs() + dy.abs());
    (if dy > 0.0 { 3.0 - p } else { 1.0 + p }) / 4.0
}

fn dist2(ax: f64, ay: f64, bx: f64, by: f64) -> f64 { (ax - bx) * (ax - bx) + (ay - by) * (ay - by) }

fn circumradius2(ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64) -> f64 {
    let (dx, dy) = (bx - ax, by - ay);
    let (ex, ey) = (cx - ax, cy - ay);
    let bl = dx * dx + dy * dy;
    let cl = ex * ex + ey * ey;
    let d = 0.5 / (dx * ey - dy * ex);
    let x = (ey * bl - dy * cl) * d;
    let y = (dx * cl - ex * bl) * d;
    x * x + y * y
}

fn circumcenter(ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64) -> (f64, f64) {
    let (dx, dy) = (bx - ax, by - ay);
    let (ex, ey) = (cx - ax, cy - ay);
    let bl = dx * dx + dy * dy;
    let cl = ex * ex + ey * ey;
    let d = 0.5 / (dx * ey - dy * ex);
    (ax + (ey * bl - dy * cl) * d, ay + (dx * cl - ex * bl) * d)
}

/// The sweep's working state.
struct Sweep {
    x: List<f64>;
    y: List<f64>;
    tri: List<usize>;
    half: List<isize>;
    hprev: List<usize>;
    hnext: List<usize>;
    htri: List<usize>;
    hash: List<isize>;
    hstart: usize;
    cx: f64;
    cy: f64;
    stack: List<usize>;
}

impl Sweep {
    fn key(self, x: f64, y: f64) -> usize {
        let n = self.hash.len();
        ((pseudo_angle(x - self.cx, y - self.cy) * (n as f64)).floor() as usize) % n
    }

    /// Whether the hull edge p -> q (clockwise hull) is visible from
    /// `r`: r, p, q turn counterclockwise.
    fn visible(self, r: usize, p: usize, q: usize) -> bool {
        orient2d(self.x[r], self.y[r], self.x[p], self.y[p], self.x[q], self.y[q]) > 0.0
    }

    fn link(self, a: usize, b: isize) {
        self.half[a] = b;
        if b != NONE { self.half[b as usize] = a as isize; }
    }

    fn add(self, i0: usize, i1: usize, i2: usize, a: isize, b: isize, c: isize) -> usize {
        let t = self.tri.len();
        self.tri.push(i0);
        self.tri.push(i1);
        self.tri.push(i2);
        self.half.push(NONE);
        self.half.push(NONE);
        self.half.push(NONE);
        self.link(t, a);
        self.link(t + 1, b);
        self.link(t + 2, c);
        t
    }

    /// Flips edges from `a` until every one passes the empty-circle
    /// test; returns the halfedge that ends at the new point.
    fn legalize(ref self, a0: usize) -> usize {
        let a = a0;
        let ar = 0usize;
        loop {
            let b = self.half[a];
            let t0 = a - a % 3;
            ar = t0 + (a + 2) % 3;
            if b == NONE {
                if self.stack.len() == 0 { break; }
                a = self.stack.pop() ?? 0;
                continue;
            }
            let b = b as usize;
            let s0 = b - b % 3;
            let al = t0 + (a + 1) % 3;
            let bl = s0 + (b + 2) % 3;
            let (p0, pr, pl, p1) = (self.tri[ar], self.tri[a], self.tri[al], self.tri[bl]);
            let x = self.x;
            let y = self.y;
            // Clockwise triangle: inside the circle is negative.
            let illegal = incircle(x[p0], y[p0], x[pr], y[pr], x[pl], y[pl], x[p1], y[p1]) < 0.0;
            if illegal {
                self.tri[a] = p1;
                self.tri[b] = p0;
                let hbl = self.half[bl];
                if hbl == NONE {
                    // The flipped edge was on the hull: repoint it.
                    let e = self.hstart;
                    loop {
                        if self.htri[e] == bl {
                            self.htri[e] = a;
                            break;
                        }
                        e = self.hprev[e];
                        if e == self.hstart { break; }
                    }
                }
                self.link(a, hbl);
                self.link(b, self.half[ar]);
                self.link(ar, bl as isize);
                let br = s0 + (b + 1) % 3;
                self.stack.push(br);
            } else {
                if self.stack.len() == 0 { break; }
                a = self.stack.pop() ?? 0;
            }
        }
        ar
    }
}

impl Delaunay {
    /// The triangulation of the rows of `points` (n x 2). At least three
    /// points not on one line are needed; all on one line throws
    /// `BadArgument` (interpolate along the line with a 1-d method).
    ///
    /// ```nabi
    /// use interpolate::scatter::Delaunay;
    /// use core::array::Matrix;
    ///
    /// let p: Matrix<f64> = [[0, 0], [2, 0], [1, 2], [1, 0.5]];
    /// assert((try Delaunay::new(p)).len() == 3);
    /// ```
    pub fn new(points: Matrix<f64>) throws (InterpError) -> Delaunay {
        let s = points.shape();
        try arg(s[1] == 2, f"Delaunay works in the plane: points must be n x 2, got {s[0]} x {s[1]}; use `NearestND` or `Rbf` in other dimensions");
        let n = s[0];
        let src = list(points);
        try finite(src, "points");
        let x = List::filled(n, 0.0);
        let y = List::filled(n, 0.0);
        for i in 0..n {
            x[i] = src[2 * i];
            y[i] = src[2 * i + 1];
        }
        let collinear = InterpError::BadArgument { what: "all points lie on one line (or fewer than 3 distinct points); a triangulation needs three that do not, so interpolate along the line with a 1-d method such as `interpolate::linear`" };
        if n < 3 { throw collinear; }
        let (minx, miny, maxx, maxy) = (f64::INFINITY, f64::INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY);
        for i in 0..n {
            minx = minx.min(x[i]);
            miny = miny.min(y[i]);
            maxx = maxx.max(x[i]);
            maxy = maxy.max(y[i]);
        }
        let (cx, cy) = ((minx + maxx) / 2.0, (miny + maxy) / 2.0);
        // Seed: the point nearest the center, its nearest neighbor, and
        // the point making the smallest circumcircle with them.
        let (i0, best) = (0usize, f64::INFINITY);
        for i in 0..n {
            let d = dist2(cx, cy, x[i], y[i]);
            if d < best { i0 = i; best = d; }
        }
        let (i1, best1) = (n, f64::INFINITY);
        for i in 0..n {
            if i == i0 { continue; }
            let d = dist2(x[i0], y[i0], x[i], y[i]);
            if d < best1 && d > 0.0 { i1 = i; best1 = d; }
        }
        if i1 == n { throw collinear; }
        let (i2, rmin) = (n, f64::INFINITY);
        for i in 0..n {
            if i == i0 || i == i1 { continue; }
            if orient2d(x[i0], y[i0], x[i1], y[i1], x[i], y[i]) == 0.0 { continue; }
            let r = circumradius2(x[i0], y[i0], x[i1], y[i1], x[i], y[i]);
            if r < rmin { i2 = i; rmin = r; }
        }
        if i2 == n { throw collinear; }
        // The sweep keeps triangles clockwise.
        if orient2d(x[i0], y[i0], x[i1], y[i1], x[i2], y[i2]) > 0.0 {
            let t = i1;
            i1 = i2;
            i2 = t;
        }
        let (ccx, ccy) = circumcenter(x[i0], y[i0], x[i1], y[i1], x[i2], y[i2]);
        let dists = List::filled(n, 0.0);
        for i in 0..n { dists[i] = dist2(x[i], y[i], ccx, ccy); }
        let ids = List::filled(n, 0usize);
        for i in 0..n { ids[i] = i; }
        ids.sort_by(|a: usize, b: usize| dists[a].total_cmp(dists[b]).then(a.cmp(b)));
        let hs = (n as f64).sqrt().ceil() as usize;
        let w = Sweep {
            x, y,
            tri: List::with_capacity(6 * n), half: List::with_capacity(6 * n),
            hprev: List::filled(n, 0usize), hnext: List::filled(n, 0usize), htri: List::filled(n, 0usize),
            hash: List::filled(hs.max(1), NONE),
            hstart: i0, cx: ccx, cy: ccy, stack: [],
        };
        w.hnext[i0] = i1;
        w.hprev[i2] = i1;
        w.hnext[i1] = i2;
        w.hprev[i0] = i2;
        w.hnext[i2] = i0;
        w.hprev[i1] = i0;
        w.htri[i0] = 0;
        w.htri[i1] = 1;
        w.htri[i2] = 2;
        w.hash[w.key(x[i0], y[i0])] = i0 as isize;
        w.hash[w.key(x[i1], y[i1])] = i1 as isize;
        w.hash[w.key(x[i2], y[i2])] = i2 as isize;
        _ = w.add(i0, i1, i2, NONE, NONE, NONE);
        let on = List::filled(n, false);
        on[i0] = true;
        on[i1] = true;
        on[i2] = true;
        let (xp, yp) = (f64::NAN, f64::NAN);
        for k in 0..n {
            let i = ids[k];
            let (px, py) = (x[i], y[i]);
            // A repeat of the previous point (same distance, same spot).
            if px == xp && py == yp { continue; }
            xp = px;
            yp = py;
            if i == i0 || i == i1 || i == i2 { continue; }
            // A visible hull edge, from the angular hash.
            let start = 0usize;
            let key = w.key(px, py);
            let hsz = w.hash.len();
            for j in 0..hsz {
                let s = w.hash[(key + j) % hsz];
                if s != NONE && w.hnext[s as usize] != s as usize {
                    start = s as usize;
                    break;
                }
            }
            start = w.hprev[start];
            let e = start;
            let found = true;
            loop {
                let q = w.hnext[e];
                if w.visible(i, e, q) { break; }
                e = q;
                if e == start {
                    found = false;
                    break;
                }
            }
            // On the hull or a repeat of an earlier point: skip it.
            if !found { continue; }
            if dup(w, i, e) { continue; }
            on[i] = true;
            let t = w.add(e, i, w.hnext[e], NONE, NONE, w.htri[e] as isize);
            w.htri[i] = w.legalize(t + 2);
            w.htri[e] = t;
            let m = w.hnext[e];
            loop {
                let q = w.hnext[m];
                if !w.visible(i, m, q) { break; }
                let t = w.add(m, i, q, w.htri[i] as isize, NONE, w.htri[m] as isize);
                w.htri[i] = w.legalize(t + 2);
                w.hnext[m] = m;
                m = q;
            }
            if e == start {
                loop {
                    let q = w.hprev[e];
                    if !w.visible(i, q, e) { break; }
                    let t = w.add(q, i, e, NONE, w.htri[e] as isize, w.htri[q] as isize);
                    _ = w.legalize(t + 2);
                    w.htri[q] = t;
                    w.hnext[e] = e;
                    e = q;
                }
            }
            w.hstart = e;
            w.hprev[i] = e;
            w.hnext[e] = i;
            w.hprev[m] = i;
            w.hnext[i] = m;
            w.hash[w.key(px, py)] = i as isize;
            w.hash[w.key(x[e], y[e])] = e as isize;
        }
        let hull: List<usize> = [];
        let e = w.hstart;
        loop {
            hull.push(e);
            e = w.hnext[e];
            if e == w.hstart { break; }
        }
        // Counterclockwise, as the triangles are reported.
        hull.reverse();
        let from = List::filled(n, NONE);
        for e in 0..w.tri.len() { from[w.tri[e]] = e as isize; }
        Delaunay { x, y, tri: w.tri, half: w.half, hull, from }
    }

    /// The number of triangles. For h hull vertices and v vertices in
    /// all (duplicates once), it is 2 v - h - 2.
    ///
    /// ```nabi
    /// use interpolate::scatter::Delaunay;
    /// use core::array::Matrix;
    ///
    /// let p: Matrix<f64> = [[0, 0], [1, 0], [0, 1]];
    /// assert((try Delaunay::new(p)).len() == 1);
    /// ```
    pub fn len(self) -> usize { self.tri.len() / 3 }

    /// The triangles, one row of three point rows each, counterclockwise.
    ///
    /// ```nabi
    /// use interpolate::scatter::Delaunay;
    /// use core::array::Matrix;
    ///
    /// let p: Matrix<f64> = [[0, 0], [1, 0], [0, 1]];
    /// let t = (try Delaunay::new(p)).simplices();
    /// assert(t.shape() == [1, 3] && t[0, 0] + t[0, 1] + t[0, 2] == 3);
    /// ```
    pub fn simplices(self) -> Matrix<usize> {
        let m = self.len();
        let out = List::filled(3 * m, 0usize);
        for t in 0..m {
            out[3 * t] = self.tri[3 * t];
            out[3 * t + 1] = self.tri[3 * t + 2];
            out[3 * t + 2] = self.tri[3 * t + 1];
        }
        Array::view_list(out, [m, 3])
    }

    /// For each triangle, the triangle across from each of its three
    /// vertices (in `simplices` order), -1 on the hull.
    ///
    /// ```nabi
    /// use interpolate::scatter::Delaunay;
    /// use core::array::Matrix;
    ///
    /// let p: Matrix<f64> = [[0, 0], [1, 0], [0, 1], [1, 1]];
    /// let nb = (try Delaunay::new(p)).neighbors();
    /// assert(nb.shape() == [2, 3] && nb[0, 0] + nb[0, 1] + nb[0, 2] == -1);
    /// ```
    pub fn neighbors(self) -> Matrix<i64> {
        let m = self.len();
        let out = List::filled(3 * m, -1i64);
        let across = |e: usize| -> i64 { if self.half[e] == NONE { -1 } else { (self.half[e] as i64) / 3 } };
        for t in 0..m {
            // simplices row (a, c, b): opposite a is b -> c, c is a -> b,
            // b is c -> a.
            out[3 * t] = across(3 * t + 1);
            out[3 * t + 1] = across(3 * t);
            out[3 * t + 2] = across(3 * t + 2);
        }
        Array::view_list(out, [m, 3])
    }

    /// The convex hull's vertices, counterclockwise.
    ///
    /// ```nabi
    /// use interpolate::scatter::Delaunay;
    /// use core::array::Matrix;
    ///
    /// let p: Matrix<f64> = [[0, 0], [2, 0], [1, 2], [1, 0.5]];
    /// assert((try Delaunay::new(p)).hull().len() == 3);
    /// ```
    pub fn hull(self) -> Vector<usize> { Array::from(self.hull.clone()) }

    /// The input points, n x 2.
    ///
    /// ```nabi
    /// use interpolate::scatter::Delaunay;
    /// use core::array::Matrix;
    ///
    /// let p: Matrix<f64> = [[0, 0], [1, 0], [0, 1]];
    /// assert((try Delaunay::new(p)).points() == p);
    /// ```
    pub fn points(self) -> Matrix<f64> {
        let n = self.x.len();
        let out = List::filled(2 * n, 0.0);
        for i in 0..n {
            out[2 * i] = self.x[i];
            out[2 * i + 1] = self.y[i];
        }
        Array::view_list(out, [n, 2])
    }

    /// The triangle (a row of `simplices`) holding `p`, or `none`
    /// outside the hull. A point on a shared edge gets one of the two.
    ///
    /// ```nabi
    /// use interpolate::scatter::Delaunay;
    /// use core::array::Matrix;
    ///
    /// let p: Matrix<f64> = [[0, 0], [1, 0], [0, 1]];
    /// assert((try Delaunay::new(p)).find_simplex([0.25, 0.25]) == 0);
    /// ```
    pub fn find_simplex(self, p: Vector<f64>) -> usize? {
        if p.len() != 2 { return none; }
        self.locate(p[0], p[1], 0)
    }

    /// The triangle holding (px, py) by a visibility walk from
    /// triangle `t0`: cross any edge that has the point strictly
    /// outside. On a Delaunay triangulation the walk cannot cycle.
    pub(pkg) fn locate(self, px: f64, py: f64, t0: usize) -> usize? {
        if !(px.is_finite() && py.is_finite()) || self.len() == 0 { return none; }
        let r = self.walk(px, py, t0, 4 * self.len() + 16);
        if r == -2 { return self.scan(px, py); }
        if r < 0 { none } else { r as usize }
    }

    /// The walk of `locate`, at most `limit` steps: the triangle, -1
    /// outside the hull, -2 when the limit ran out.
    pub(pkg) fn walk(self, px: f64, py: f64, t0: usize, limit: usize) -> isize {
        let t = t0;
        let steps = 0usize;
        loop {
            let moved = false;
            for j in 0..3 {
                let e = 3 * t + (j + steps) % 3;
                let (a, b) = (self.tri[e], self.tri[next(e)]);
                // Clockwise: the inside is to the right of a -> b.
                if orient2d(self.x[a], self.y[a], self.x[b], self.y[b], px, py) > 0.0 {
                    if self.half[e] == NONE { return -1; }
                    t = (self.half[e] as usize) / 3;
                    moved = true;
                    break;
                }
            }
            if !moved { return t as isize; }
            steps += 1;
            if steps > limit { return -2; }
        }
    }

    fn scan(self, px: f64, py: f64) -> usize? {
        for t in 0..self.len() {
            let inside = true;
            for j in 0..3 {
                let e = 3 * t + j;
                let (a, b) = (self.tri[e], self.tri[next(e)]);
                if orient2d(self.x[a], self.y[a], self.x[b], self.y[b], px, py) > 0.0 { inside = false; }
            }
            if inside { return t; }
        }
        none
    }

    /// The barycentric coordinates of `p` in triangle `t` (a row of
    /// `simplices`), in its vertex order; they sum to 1 and all are
    /// in [0, 1] inside it.
    ///
    /// ```nabi
    /// use interpolate::scatter::Delaunay;
    /// use core::array::Matrix;
    ///
    /// let p: Matrix<f64> = [[0, 0], [1, 0], [0, 1]];
    /// let d = try Delaunay::new(p);
    /// let w = d.barycentric(0, [0.25, 0.5]);
    /// assert((w[0] + w[1] + w[2] - 1.0).abs() < 1e-15);
    /// ```
    pub fn barycentric(self, t: usize, p: Vector<f64>) -> Vector<f64> {
        let (a, b, c) = self.weights(t, p[0], p[1]);
        Array::from([a, b, c])
    }

    /// Barycentric weights of (px, py) for simplices row `t` = (A, C, B)
    /// of the clockwise (A, B, C).
    pub(pkg) fn weights(self, t: usize, px: f64, py: f64) -> (f64, f64, f64) {
        let (a, b, c) = (self.tri[3 * t], self.tri[3 * t + 2], self.tri[3 * t + 1]);
        let (x, y) = (self.x, self.y);
        let det = (y[b] - y[c]) * (x[a] - x[c]) + (x[c] - x[b]) * (y[a] - y[c]);
        let la = ((y[b] - y[c]) * (px - x[c]) + (x[c] - x[b]) * (py - y[c])) / det;
        let lb = ((y[c] - y[a]) * (px - x[c]) + (x[a] - x[c]) * (py - y[c])) / det;
        (la, lb, 1.0 - la - lb)
    }

    /// The triangle that touches point row `v`, when `v` is a vertex.
    pub(pkg) fn around(self, v: usize) -> usize? {
        if v >= self.from.len() || self.from[v] == NONE { none } else { (self.from[v] as usize) / 3 }
    }
}

/// Whether point `i` repeats a vertex of the hull edge `e` -> next.
fn dup(w: Sweep, i: usize, e: usize) -> bool {
    let q = w.hnext[e];
    (w.x[i] == w.x[e] && w.y[i] == w.y[e]) || (w.x[i] == w.x[q] && w.y[i] == w.y[q])
}
