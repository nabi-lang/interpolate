// Local cubic Hermite interpolants: PCHIP (shape preserving), Akima and
// modified Akima (few wiggles), and Hermite from given slopes. Each is a
// `PPoly` built in O(n).

use pkg::data::{finite, list, pairs, same};
use pkg::ppoly::hermite;
use pkg::{InterpError, PPoly};
use core::array::Vector;
use linalg::AsVector;

/// The cubic Hermite interpolant with values `y` and slopes `dydx` at
/// `x`: C1, exact for cubics when the slopes are exact.
///
/// ```nabi
/// use interpolate::Curve;
///
/// // x^3 with exact slopes 3x^2.
/// let p = try interpolate::cubic_hermite([0, 1, 2], [0, 1, 8], [0, 3, 12]);
/// assert((p.at(1.5) - 3.375).abs() < 1e-15);
/// ```
pub fn cubic_hermite<X: AsVector<f64>, Y: AsVector<f64>, D: AsVector<f64>>(x: X, y: Y, dydx: D) throws (InterpError) -> PPoly {
    let x: Vector<f64> = x.as_vector();
    let y: Vector<f64> = y.as_vector();
    let dydx: Vector<f64> = dydx.as_vector();
    let (xs, ys) = try pairs(x, y, 2);
    let ds = list(dydx);
    try same(xs.len(), ds.len(), "x", "dydx");
    try finite(ds, "dydx");
    hermite(xs, ys, ds)
}

/// The secant slopes `(y[i + 1] - y[i]) / (x[i + 1] - x[i])`.
fn secants(x: List<f64>, y: List<f64>) -> List<f64> {
    let m = List::filled(x.len() - 1, 0.0);
    for i in 0..x.len() - 1 { m[i] = (y[i + 1] - y[i]) / (x[i + 1] - x[i]); }
    m
}

/// PCHIP, the piecewise cubic Hermite interpolating polynomial of
/// Fritsch and Carlson (1980) with the slopes of Fritsch and Butland
/// (1984): a weighted harmonic mean of the neighbouring secants, zero
/// where they change sign, and a shape-preserving three-point formula at
/// the ends. The result is C1 and monotone wherever the data are, with
/// no overshoot at a step. Exact for lines.
///
/// ```nabi
/// use interpolate::Curve;
///
/// let p = try interpolate::pchip([0, 1, 2, 3], [0, 0, 1, 1]);
/// assert(p.at(0.5) == 0.0 && p.at(2.5) == 1.0);   // flat stays flat
/// assert(p.at(1.5) == 0.5);
/// ```
pub fn pchip<X: AsVector<f64>, Y: AsVector<f64>>(x: X, y: Y) throws (InterpError) -> PPoly {
    let x: Vector<f64> = x.as_vector();
    let y: Vector<f64> = y.as_vector();
    let (xs, ys) = try pairs(x, y, 2);
    let n = xs.len();
    let m = secants(xs, ys);
    let d = List::filled(n, 0.0);
    if n == 2 {
        d[0] = m[0];
        d[1] = m[0];
        return hermite(xs, ys, d);
    }
    for k in 1..n - 1 {
        let (h0, h1) = (xs[k] - xs[k - 1], xs[k + 1] - xs[k]);
        if m[k - 1] * m[k] <= 0.0 { continue; }
        let w1 = 2.0 * h1 + h0;
        let w2 = h1 + 2.0 * h0;
        d[k] = (w1 + w2) / (w1 / m[k - 1] + w2 / m[k]);
    }
    d[0] = edge(xs[1] - xs[0], xs[2] - xs[1], m[0], m[1]);
    d[n - 1] = edge(xs[n - 1] - xs[n - 2], xs[n - 2] - xs[n - 3], m[n - 2], m[n - 3]);
    hermite(xs, ys, d)
}

/// The end slope: the three-point estimate, limited so the end piece
/// keeps the sign and shape of the data.
fn edge(h0: f64, h1: f64, m0: f64, m1: f64) -> f64 {
    let d = ((2.0 * h0 + h1) * m0 - h0 * m1) / (h0 + h1);
    if d.signum() != m0.signum() || m0 == 0.0 {
        0.0
    } else if m0.signum() != m1.signum() && d.abs() > 3.0 * m0.abs() {
        3.0 * m0
    } else {
        d
    }
}

/// Akima's (1970) interpolant: slopes from the four nearest secants,
/// weighted by how much they change, so an outlier moves only the
/// pieces next to it. C1; exact for lines. Two extra secants at each
/// end are extrapolated linearly, as Akima does.
///
/// ```nabi
/// use interpolate::Curve;
///
/// let a = try interpolate::akima([0, 1, 2, 3, 4, 5], [0, 0, 0, 1, 1, 1]);
/// assert(a.at(0.5) == 0.0 && a.at(4.5) == 1.0);
/// ```
pub fn akima<X: AsVector<f64>, Y: AsVector<f64>>(x: X, y: Y) throws (InterpError) -> PPoly {
    let x: Vector<f64> = x.as_vector();
    let y: Vector<f64> = y.as_vector();
    try akima_with(x, y, false)
}

/// The modified Akima interpolant (MATLAB's `makima`): Akima's weights
/// plus the mean of each pair of secants, which removes the overshoot
/// of plain Akima where the data are flat on one side.
///
/// ```nabi
/// use interpolate::Curve;
///
/// let a = try interpolate::makima([0, 1, 2, 3, 4], [0, 0, 1, 1, 1]);
/// assert(a.at(3.5) == 1.0);
/// ```
pub fn makima<X: AsVector<f64>, Y: AsVector<f64>>(x: X, y: Y) throws (InterpError) -> PPoly {
    let x: Vector<f64> = x.as_vector();
    let y: Vector<f64> = y.as_vector();
    try akima_with(x, y, true)
}

fn akima_with(x: Vector<f64>, y: Vector<f64>, modified: bool) throws (InterpError) -> PPoly {
    let (xs, ys) = try pairs(x, y, 2);
    let n = xs.len();
    let s = secants(xs, ys);
    // e[j + 2] = s[j]; two extrapolated secants at each end.
    let e = List::filled(n + 3, 0.0);
    for j in 0..n - 1 { e[j + 2] = s[j]; }
    if n == 2 {
        e[1] = s[0];
        e[0] = s[0];
        e[n + 1] = s[0];
        e[n + 2] = s[0];
    } else {
        e[1] = 2.0 * e[2] - e[3];
        e[0] = 2.0 * e[1] - e[2];
        e[n + 1] = 2.0 * e[n] - e[n - 1];
        e[n + 2] = 2.0 * e[n + 1] - e[n];
    }
    let big = 0.0;
    for j in 0..n + 2 { big = big.max((e[j + 1] - e[j]).abs()); }
    let d = List::filled(n, 0.0);
    for i in 0..n {
        let (a, b, c, q) = (e[i], e[i + 1], e[i + 2], e[i + 3]);
        let w1 = (q - c).abs() + (if modified { 0.5 * (q + c).abs() } else { 0.0 });
        let w2 = (b - a).abs() + (if modified { 0.5 * (b + a).abs() } else { 0.0 });
        d[i] = if w1 + w2 > 1e-9 * big { (w1 * b + w2 * c) / (w1 + w2) } else { 0.5 * (b + c) };
    }
    hermite(xs, ys, d)
}
