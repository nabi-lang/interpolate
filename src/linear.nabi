// Piecewise-linear and step interpolation, the `np.interp` family.

use pkg::curve::{fill, wrap};
use pkg::data::{interval, interval_from, list, pairs};
use pkg::{Curve, Extrapolate, InterpError, PPoly};
use core::array::{Array, Vector};
use linalg::AsVector;

/// The piecewise-linear interpolant of samples: exact for lines, error
/// `h^2 max|f''| / 8` for smooth `f` and spacing `h`. O(log n) per point,
/// O(1) per point in a sorted `eval`.
///
/// ```nabi
/// use interpolate::Curve;
///
/// let f = try interpolate::linear([0, 1, 3], [0, 10, 30]);
/// assert(f.at(2.0) == 20.0 && f.at(-1.0) == -10.0);
/// ```
#[derive(Clone)]
pub struct Linear {
    x: List<f64>;
    y: List<f64>;
    mode: Extrapolate;
}

/// Linear interpolation through `(x[i], y[i])`, `x` rising strictly,
/// at least 2 points. Outside the data it continues the end segments;
/// set another mode with `extrapolate`.
///
/// ```nabi
/// use interpolate::{Curve, Extrapolate};
/// use core::array::Vector;
///
/// let f = try interpolate::linear([1, 2, 4], [1, 4, 16]);
/// let xs: Vector<f64> = [1.5, 3.0];
/// assert(f.eval(xs) == Vector::<f64>::from([2.5, 10.0]));
/// assert(f.extrapolate(Extrapolate::Clamp).at(9.0) == 16.0);
/// ```
pub fn linear<X: AsVector<f64>, Y: AsVector<f64>>(x: X, y: Y) throws (InterpError) -> Linear {
    let x: Vector<f64> = x.as_vector();
    let y: Vector<f64> = y.as_vector();
    let (xs, ys) = try pairs(x, y, 2);
    Linear { x: xs.clone(), y: ys.clone(), mode: Extrapolate::Extend }
}

impl Linear {
    /// This interpolant with extrapolation `mode`.
    ///
    /// ```nabi
    /// use interpolate::{Curve, Extrapolate};
    ///
    /// let f = try interpolate::linear([0, 1], [0, 1]);
    /// assert(f.extrapolate(Extrapolate::Fill(7.0)).at(2.0) == 7.0);
    /// ```
    pub fn extrapolate(self, mode: Extrapolate) -> Linear { Linear { x: self.x, y: self.y, mode } }

    /// The same function as a degree-1 `PPoly`, for derivatives,
    /// integrals and roots.
    ///
    /// ```nabi
    /// let p = try interpolate::linear([0, 1, 2], [0, 1, 0]).ppoly();
    /// assert(p.integrate(0.0..2.0) == 1.0);
    /// ```
    pub fn ppoly(self) -> PPoly {
        let n = self.x.len() - 1;
        let c = List::filled(2 * n, 0.0);
        for i in 0..n {
            c[2 * i] = self.y[i];
            c[2 * i + 1] = (self.y[i + 1] - self.y[i]) / (self.x[i + 1] - self.x[i]);
        }
        PPoly::raw(self.x.clone(), 1, c).extrapolate(self.mode)
    }

    fn seg(self, i: usize, t: f64) -> f64 {
        let (x0, x1) = (self.x[i], self.x[i + 1]);
        let (y0, y1) = (self.y[i], self.y[i + 1]);
        let s = (t - x0) / (x1 - x0);
        // Exact at both ends.
        if s <= 0.5 { y0 + s * (y1 - y0) } else { y1 - (1.0 - s) * (y1 - y0) }
    }
}

impl Curve for Linear {
    fn at(self, x: f64) -> f64 {
        let t = wrap(self.mode, x, self.x[0], self.x[self.x.len() - 1]) ?? return fill(self.mode);
        self.seg(interval(self.x, t), t)
    }

    fn eval<const N: usize>(self, xs: Array<f64, N>) -> Array<f64, N> {
        let src = list(xs);
        let out = List::filled(src.len(), 0.0);
        let (lo, hi) = (self.x[0], self.x[self.x.len() - 1]);
        let i = 0usize;
        for m in 0..src.len() {
            let x = src[m];
            if (x >= lo && x <= hi) || self.mode == Extrapolate::Extend {
                i = interval_from(self.x, x, i);
                out[m] = self.seg(i, x);
            } else {
                out[m] = self.at(x);
            }
        }
        Array::view_list(out, xs.shape())
    }
}

/// Which sample a step interpolant takes.
///
/// ```nabi
/// use interpolate::{Curve, StepKind};
///
/// let f = try interpolate::step([0, 1, 2], [5, 6, 7], StepKind::Next);
/// assert(f.at(0.2) == 6.0);
/// ```
#[derive(Clone, Copy, PartialEq, Debug)]
pub enum StepKind {
    /// The closest sample; the lower one at a midpoint.
    Nearest,
    /// The last sample at or before `x`.
    Previous,
    /// The first sample at or after `x`.
    Next,
}

/// A piecewise-constant interpolant (`nearest`, `previous`, `next`).
///
/// ```nabi
/// use interpolate::Curve;
///
/// let f = try interpolate::nearest([0, 1, 2], [5, 6, 7]);
/// assert(f.at(1.4) == 6.0 && f.at(1.5) == 6.0 && f.at(1.6) == 7.0);
/// ```
#[derive(Clone)]
pub struct Step {
    x: List<f64>;
    y: List<f64>;
    kind: StepKind;
    mode: Extrapolate;
}

/// A step interpolant of `kind` through the samples (at least 1). Outside
/// the data `Extend` holds the end values, as `Clamp` does; `previous`
/// before the first sample and `next` after the last take the end value
/// too.
///
/// ```nabi
/// use interpolate::{Curve, StepKind};
///
/// let f = try interpolate::step([0, 10], [1, 2], StepKind::Previous);
/// assert(f.at(9.9) == 1.0 && f.at(10.0) == 2.0);
/// ```
pub fn step<X: AsVector<f64>, Y: AsVector<f64>>(x: X, y: Y, kind: StepKind) throws (InterpError) -> Step {
    let x: Vector<f64> = x.as_vector();
    let y: Vector<f64> = y.as_vector();
    let (xs, ys) = try pairs(x, y, 1);
    Step { x: xs.clone(), y: ys.clone(), kind, mode: Extrapolate::Extend }
}

/// `step(x, y, StepKind::Nearest)`.
///
/// ```nabi
/// use interpolate::Curve;
///
/// assert((try interpolate::nearest([0, 2], [1, 3])).at(0.9) == 1.0);
/// ```
pub fn nearest<X: AsVector<f64>, Y: AsVector<f64>>(x: X, y: Y) throws (InterpError) -> Step {
    let x: Vector<f64> = x.as_vector();
    let y: Vector<f64> = y.as_vector();
    try step(x, y, StepKind::Nearest)
}

/// `step(x, y, StepKind::Previous)`.
///
/// ```nabi
/// use interpolate::Curve;
///
/// assert((try interpolate::previous([0, 2], [1, 3])).at(1.9) == 1.0);
/// ```
pub fn previous<X: AsVector<f64>, Y: AsVector<f64>>(x: X, y: Y) throws (InterpError) -> Step {
    let x: Vector<f64> = x.as_vector();
    let y: Vector<f64> = y.as_vector();
    try step(x, y, StepKind::Previous)
}

/// `step(x, y, StepKind::Next)`.
///
/// ```nabi
/// use interpolate::Curve;
///
/// assert((try interpolate::next([0, 2], [1, 3])).at(0.1) == 3.0);
/// ```
pub fn next<X: AsVector<f64>, Y: AsVector<f64>>(x: X, y: Y) throws (InterpError) -> Step {
    let x: Vector<f64> = x.as_vector();
    let y: Vector<f64> = y.as_vector();
    try step(x, y, StepKind::Next)
}

impl Step {
    /// This interpolant with extrapolation `mode`.
    ///
    /// ```nabi
    /// use interpolate::{Curve, Extrapolate};
    ///
    /// let f = try interpolate::nearest([0, 1], [3, 4]);
    /// assert(f.extrapolate(Extrapolate::Fill(0.0)).at(5.0) == 0.0);
    /// ```
    pub fn extrapolate(self, mode: Extrapolate) -> Step { Step { x: self.x, y: self.y, kind: self.kind, mode } }

    fn pick(self, i: usize, t: f64) -> f64 {
        // x[i] <= t < x[i + 1], or an end.
        let n = self.x.len();
        if n == 1 { return self.y[0]; }
        if t <= self.x[0] { return self.y[0]; }
        if t >= self.x[n - 1] { return self.y[n - 1]; }
        match self.kind {
            StepKind::Previous => self.y[i],
            StepKind::Next => if t == self.x[i] { self.y[i] } else { self.y[i + 1] },
            StepKind::Nearest => if t - self.x[i] <= self.x[i + 1] - t { self.y[i] } else { self.y[i + 1] },
        }
    }
}

impl Curve for Step {
    fn at(self, x: f64) -> f64 {
        let n = self.x.len();
        let t = wrap(self.mode, x, self.x[0], self.x[n - 1]) ?? return fill(self.mode);
        if t.is_nan() { return t; }
        let i = if n >= 2 { interval(self.x, t) } else { 0 };
        self.pick(i, t)
    }
}
