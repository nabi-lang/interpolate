// Integration and differentiation. Quadrature benches time one call;
// sampled rules count samples as items, so items/s reads as samples/s.

use core::array::{Array, Vector};
use core::bench::Bench;
use core::hint::black_box;

fn samples(n: usize) -> Vector<f64> {
    let xs: List<f64> = List::with_capacity(n);
    for i in 0..n { xs.push(((i as f64) * 1e-6).sin()); }
    Array::from_list(xs, [n])
}

#[bench]
fn quad_smooth(b: Bench) {
    b.iter(|| try! pkg::quad(black_box(|x: f64| -> f64 { (-x * x).exp() * x.cos() }), 0.0..3.0, epsabs: 0.0, epsrel: 1e-12));
}

#[bench]
fn quad_oscillatory(b: Bench) {
    b.iter(|| try! pkg::quad(black_box(|x: f64| -> f64 { (100.0 * x).sin() * x }), 0.0..10.0, limit: 200));
}

#[bench]
fn quad_singular(b: Bench) {
    b.iter(|| try! pkg::quad(black_box(|x: f64| -> f64 { x.ln() / x.sqrt() }), 0.0..1.0));
}

#[bench]
fn quad_infinite(b: Bench) {
    b.iter(|| try! pkg::quad(black_box(|x: f64| -> f64 { 1.0 / (1.0 + x * x) }), f64::NEG_INFINITY..f64::INFINITY));
}

#[bench]
fn romberg_smooth(b: Bench) {
    b.iter(|| try! pkg::romberg(black_box(f64::exp), 0.0..1.0, tol: 1e-12, rtol: 1e-12));
}

#[bench]
fn dblquad_gauss(b: Bench) {
    b.iter(|| try! pkg::dblquad(black_box(|x: f64, y: f64| -> f64 { (-(x * x + y * y)).exp() }), 0.0..2.0, 0.0..2.0));
}

#[bench]
fn trapezoid_1m(b: Bench) {
    let y = samples(1000000);
    b.set_items(1000000);
    b.iter(|| try! pkg::trapezoid(black_box(y), 1e-6));
}

#[bench]
fn simpson_1m(b: Bench) {
    let y = samples(1000001);
    b.set_items(1000001);
    b.iter(|| try! pkg::simpson(black_box(y), 1e-6));
}

#[bench]
fn cumulative_1m(b: Bench) {
    let y = samples(1000000);
    b.set_items(1000000);
    b.iter(|| try! pkg::cumulative_trapezoid(black_box(y), 1e-6));
}

#[bench]
fn gradient_1m(b: Bench) {
    let y = samples(1000000);
    b.set_items(1000000);
    b.iter(|| try! pkg::gradient(black_box(y), 1e-6));
}

#[bench]
fn differentiate_1m(b: Bench) {
    let y = samples(1000000);
    b.set_items(1000000);
    b.iter(|| try! pkg::differentiate(black_box(y), 1e-6, accuracy: 4));
}

#[bench]
fn gradient_nd_1000x1000(b: Bench) {
    let a: Array<f64, 2> = Array::from_list(samples(1000000).to_list(), [1000, 1000]);
    b.set_items(1000000);
    b.iter(|| try! pkg::gradient_nd(black_box(a)));
}
